# URL of the deployed notifyCaregiver endpoint — an API Gateway HTTP API in
# front of the SES Lambda (see lambda/notifyCaregiver/README.md).
# Copy this file to .env and fill in the real value — .env itself is gitignored.
VITE_CAREGIVER_EMAIL_ENDPOINT=

# URL of the deployed silverGuardAuth endpoint (API Gateway HTTP API in front of the auth Lambda).
VITE_AUTH_ENDPOINT=
